{
  "id": "bpq",
  "name": "BPQ MailChat",
  "version": 1,

  "prompt": {
    "pattern": "de\\s+\\S+>",
    "display": "BPQ prompt 'de CALL>'",
    "case_insensitive": true
  },

  "commands": {
    "list_mine": "LM",
    "read": "R {msgno}",
    "kill": "K {msgno}",
    "bye": "B"
  },

  "list_mine": {
    "header_start_pattern": "",
    "entry_pattern": "^(?P<msgno>\\d+)\\s+(?P<date>\\d{1,2}-[A-Za-z]{3})\\s+(?P<status>\\S+)\\s+(?P<size>\\d+)\\s+(?P<to>\\S+)\\s+(?:(?P<route>@\\S+)\\s+)?(?P<from>\\S+)\\s+(?P<subject>.+)$",
    "date_source": "list_row",
    "date_format": "%d-%b"
  },

  "sent_at": {
    "source": "msg_header",
    "field": "sent_at",
    "formats": ["d_mon_hm_z", "d_mon_hm"],
    "assume_timezone": "utc"
  },

  "read_message": {
    "from_pattern": "^From:\\s*(?P<from>.+)$",
    "to_pattern": "^To:\\s*(?P<to>.+)$",
    "type_status_pattern": "^Type/Status:?\\s*(?P<status>.+)$",
    "datetime_pattern": "^Date/Time:\\s*(?P<sent_at>\\d{1,2}-[A-Za-z]{3}\\s+\\d{1,2}:\\d{2}Z?)$",
    "bbsmsgno_pattern": "^Bid:\\s*(?P<bbsmsgno>.+)$",
    "subject_pattern": "^Title:\\s*(?P<subject>.+)$",
    "body_start_after_blank": true,
    "body_end_pattern": "^\\[End of Message #(?P<msgno>\\d+) from (?P<from_end>\\S+)\\]"
  }
}